PROJECT_NAME=NetGuardian
VERSION=1.0.0
ENVIRONMENT=development
DATABASE_URL=sqlite:///./netguardian.db
SECRET_KEY=netguardian-super-secure-jwt-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Demo User Credentials (DEMO ONLY - DO NOT USE IN PRODUCTION)
DEMO_ADMIN_PASSWORD=admin123
DEMO_ANALYST_PASSWORD=analyst123

# Detection Engine Thresholds
TRAFFIC_ANOMALY_THRESHOLD=3.0
PORT_SCAN_THRESHOLD=15
FAILED_AUTH_THRESHOLD=5
SIMULATION_TICK_SECONDS=2
SYSTEM_MODE=SIMULATION
